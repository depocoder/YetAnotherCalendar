# 🏗️ Core Settings
YET_ANOTHER_CALENDAR_WORKERS_COUNT=10
YET_ANOTHER_CALENDAR_DEBUG=False

# 🔐 Security & Authentication
# Generate hash with: python generate_password_hash.py
YET_ANOTHER_CALENDAR_TUTOR_PASSWORD_HASH=""
YET_ANOTHER_CALENDAR_TUTOR_SECRET_KEY="change-this-secret-key-in-production"

# Modeus Donor Account (for tutor access)
YET_ANOTHER_CALENDAR_MODEUS_USERNAME=""
YET_ANOTHER_CALENDAR_MODEUS_PASSWORD=""

# 🛡️ Rate Limiting Protection
YET_ANOTHER_CALENDAR_LOGIN_MAX_ATTEMPTS=5
YET_ANOTHER_CALENDAR_LOGIN_LOCKOUT_TIME=900

# 🌐 External Services
NETOLOGY_DEFAULT_COURSE_ID=45526
NETOLOGY_COURSE_NAME="Разработка ИТ-продуктов и информационных систем"
NETOLOGY_URL="https://netology.ru"

# 🔐 ICS subscription: server-side pepper for credential encryption.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The feature stays disabled while this is empty.
YET_ANOTHER_CALENDAR_ICS_PEPPER=""

# Application Domain
YET_ANOTHER_CALENDAR_APP_DOMAIN="https://yetanothercalendar.ru"